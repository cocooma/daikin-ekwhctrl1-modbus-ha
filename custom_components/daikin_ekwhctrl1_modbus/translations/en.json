{
  "config": {
    "step": {
      "user": {
        "title": "Add Modbus gateway",
        "description": "Enter the Modbus TCP gateway (RS485 to Ethernet converter) the EKWHCTRL1 / EKRTCTRL1 wall controls are wired to. Wall controls are added afterwards.",
        "data": {
          "name": "Name",
          "host": "Host",
          "port": "Port",
          "framing": "Protocol",
          "scan_interval": "Poll interval (seconds)"
        },
        "data_description": {
          "framing": "Use \"Modbus RTU over TCP\" for transparent serial servers (Waveshare, USR, Elfin in transparent mode) and \"Modbus TCP\" for gateways that convert the protocol. The serial side must be 9600 baud, 8 data bits, no parity, 1 stop bit.",
          "scan_interval": "Each poll reads about a dozen registers per wall control, one request each, so very short intervals with many units can overload the bus."
        }
      },
      "reconfigure": {
        "title": "Reconfigure Modbus gateway",
        "data": {
          "name": "Name",
          "host": "Host",
          "port": "Port",
          "framing": "Protocol",
          "scan_interval": "Poll interval (seconds)"
        },
        "data_description": {
          "framing": "Use \"Modbus RTU over TCP\" for transparent serial servers (Waveshare, USR, Elfin in transparent mode) and \"Modbus TCP\" for gateways that convert the protocol. The serial side must be 9600 baud, 8 data bits, no parity, 1 stop bit.",
          "scan_interval": "Each poll reads about a dozen registers per wall control, one request each, so very short intervals with many units can overload the bus."
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to the gateway. Check host, port and that the gateway is powered."
    },
    "abort": {
      "already_configured": "A gateway with this host and port is already configured.",
      "reconfigure_successful": "The gateway was updated."
    }
  },
  "config_subentries": {
